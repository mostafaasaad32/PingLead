# ==============================================================================
# PingLead / AI Lead Radar - Environment Variables Configuration
# ==============================================================================

# Google Gemini API Key (Get free from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot Credentials (Get from @BotFather and @RawDataBot)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_numerical_chat_id

# Supabase Credentials (For Phase 1+)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only. Never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Scraper Credentials (Optional for Phase 2)
SOCIALDATA_API_KEY=your_socialdata_api_key
SERPER_API_KEY=your_serper_api_key

# Cron Secret Security Key
CRON_SECRET=generate_a_long_random_string

# Telegram webhook secret (passed as secret_token to setWebhook)
TELEGRAM_WEBHOOK_SECRET=generate_another_long_random_string

# Public site URL (used in Telegram buttons)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# EGP per 1 USD, used only if the live exchange-rate API is unreachable
USD_EGP_FALLBACK_RATE=50

# Monthly AI allowances per user (optional)
# MONTHLY_AI_CREDITS=25        # AI proposals
# MONTHLY_AI_EVALUATIONS=300   # AI project evaluations (filter criteria)

# Browser notifications (Web Push). Generate once: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# Email digest (Resend). EMAIL_FROM must be on a domain verified in Resend
RESEND_API_KEY=
EMAIL_FROM=PingLead <alerts@example.com>

# Shown on /privacy and /terms for privacy & deletion requests
NEXT_PUBLIC_CONTACT_EMAIL=
